{
  "name": "genesys-open-messaging-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "build": "tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.1.4",
    "antd": "^6.6.4",
    "argon2": "^0.45.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
